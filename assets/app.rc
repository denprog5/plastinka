#pragma code_page(65001)

1 ICON "icon.ico"
2 ICON "tray-idle.ico"

// Манифест (RT_MANIFEST = 24): asInvoker — права администратора не нужны.
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", "denprog5"
      VALUE "FileDescription", "Пластинка — сейчас играет на стриме"
      VALUE "InternalName", "plastinka"
      VALUE "LegalCopyright", "© 2026 denprog5, MIT"
      VALUE "ProductName", "Пластинка"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductVersion", "1.1.0"
      VALUE "OriginalFilename", "plastinka.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x419, 1200
  END
END
